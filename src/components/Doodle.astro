---
/**
 * Hand-drawn beach doodles, used as decorative personality across the site.
 * Single-line illustration style. Colour with a text-colour utility; size with
 * width/height classes. Always decorative, so always aria-hidden.
 */
import type { DoodleName } from '../lib/doodles';

interface Props {
  name: DoodleName;
  class?: string;
}

const { name, class: cls = '' } = Astro.props;
---

<svg
  viewBox="0 0 64 64"
  class={cls}
  fill="none"
  stroke="currentColor"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'sun' && (
      <>
        <circle cx="32" cy="32" r="9" />
        <path d="M32 6v7M32 51v7M6 32h7M51 32h7M14 14l5 5M45 45l5 5M50 14l-5 5M19 45l-5 5" />
      </>
    )
  }
  {
    name === 'wave' && (
      <path d="M7 23q6-9 12 0t12 0 12 0 12 0M7 34q6-9 12 0t12 0 12 0 12 0M7 45q6-9 12 0t12 0 12 0 12 0" />
    )
  }
  {
    name === 'shell' && (
      <>
        <path d="M32 54C16 54 9 32 32 9C55 32 48 54 32 54Z" />
        <path d="M32 54 18 27M32 54 25 16M32 54v-43M32 54 39 16M32 54 46 27" />
      </>
    )
  }
  {
    name === 'starfish' && (
      <>
        <path d="M32 7 37.9 23.9 55.8 24.3 41.5 35.1 46.7 52.2 32 42 17.3 52.2 22.5 35.1 8.2 24.3 26.1 23.9Z" />
        <circle cx="32" cy="25" r="1.6" fill="currentColor" stroke="none" />
        <circle cx="27" cy="34" r="1.6" fill="currentColor" stroke="none" />
        <circle cx="37" cy="34" r="1.6" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'flower' && (
      <>
        <circle cx="32" cy="18" r="8" />
        <circle cx="45.3" cy="27.7" r="8" />
        <circle cx="40.2" cy="43.3" r="8" />
        <circle cx="23.8" cy="43.3" r="8" />
        <circle cx="18.7" cy="27.7" r="8" />
        <circle cx="32" cy="32" r="5.5" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'sprout' && (
      <>
        <path d="M32 56V26" />
        <path d="M32 37C21 38 15 30 18 20C29 20 33 28 32 37Z" />
        <path d="M32 32C43 33 49 25 46 15C35 15 31 24 32 32Z" />
      </>
    )
  }
  {
    name === 'sparkle' && (
      <path d="M32 8C34 23 41 30 56 32C41 34 34 41 32 56C30 41 23 34 8 32C23 30 30 23 32 8Z" />
    )
  }
</svg>
