---
/**
 * One chapter band of a story page. Children marked with data-reveal animate
 * in as the chapter scrolls into view. The reveal observer below runs once
 * for the whole page however many chapters there are.
 */
interface Props {
  /** Small label above the heading, e.g. "Chapter one". */
  eyebrow?: string;
  heading?: string;
  id?: string;
  /** Background treatment; lets a story build colour as it is read. */
  tone?: 'sand' | 'sand-deep' | 'paper' | 'accent' | 'ink';
  class?: string;
}

const { eyebrow, heading, id, tone = 'sand', class: cls = '' } = Astro.props;

const toneClass = {
  sand: 'bg-sand text-ink',
  'sand-deep': 'bg-sand-deep text-ink',
  paper: 'bg-paper text-ink',
  accent: 'text-ink',
  ink: 'bg-ink text-sand',
}[tone];
---

<section
  id={id}
  data-story-chapter
  class={`story-chapter relative px-5 py-20 sm:py-28 ${toneClass} ${cls}`}
  style={tone === 'accent'
    ? 'background-color: color-mix(in oklch, var(--accent) 14%, var(--color-sand));'
    : undefined}
>
  <div class="mx-auto max-w-3xl">
    {
      eyebrow && (
        <p
          data-reveal
          class="font-hand text-2xl leading-none text-[var(--accent)]"
        >
          {eyebrow}
        </p>
      )
    }
    {
      heading && (
        <h2
          data-reveal
          style="--reveal-delay: 0.08s"
          class="mt-3 font-display text-3xl leading-tight sm:text-4xl"
        >
          {heading}
        </h2>
      )
    }
    <div data-reveal style="--reveal-delay: 0.16s" class="mt-6">
      <slot />
    </div>
  </div>
</section>

<script>
  const reveal = () => {
    const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!items.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.18, rootMargin: '0px 0px -8% 0px' },
    );

    items.forEach((item) => io.observe(item));
  };

  if (document.readyState !== 'loading') reveal();
  else document.addEventListener('DOMContentLoaded', reveal);
</script>
