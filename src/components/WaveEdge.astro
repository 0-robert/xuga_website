---
/**
 * A decorative wavy edge for the top of a section. The section above appears
 * to spill down into this one in a soft beach wave.
 *
 * Place as the first child of a `position: relative` section and pass `color`
 * as the CSS colour of the section ABOVE. Works inside overflow-hidden
 * sections because it sits within the section's own box.
 */
interface Props {
  /** CSS colour of the preceding section (the colour that spills down). */
  color: string;
  class?: string;
}

const { color, class: cls = '' } = Astro.props;
---

<span
  class={`wave-edge ${cls}`}
  style={`color:${color}`}
  aria-hidden="true"
>
  <svg viewBox="0 0 1200 44" preserveAspectRatio="none">
    <path
      d="M0 0H1200V22Q1100 0 1000 22T800 22T600 22T400 22T200 22T0 22Z"
      fill="currentColor"></path>
  </svg>
</span>

<style>
  .wave-edge {
    position: absolute;
    inset: 0 0 auto 0;
    height: clamp(20px, 3.4vw, 38px);
    line-height: 0;
    z-index: 1;
    pointer-events: none;
  }
  .wave-edge svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
