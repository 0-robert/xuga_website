---
import { Image } from 'astro:assets';
import logo from '../assets/xuga-logo.png';
import { NAV, SITE } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-ink/10 bg-sand/85 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-2.5"
  >
    <a
      href="/"
      class="group flex items-center gap-2.5"
      aria-label={`${SITE.brand}, ${SITE.tagline}. Home`}
    >
      <Image
        src={logo}
        alt=""
        width={96}
        height={96}
        class="h-11 w-11 transition-transform duration-300 ease-soft group-hover:rotate-[-8deg]"
      />
      <span class="leading-none">
        <span class="block font-display text-xl font-semibold text-ink"
          >XUGA</span
        >
        <span
          class="block text-[0.6rem] font-semibold tracking-[0.22em] text-ink-soft uppercase"
          >Island Wear</span
        >
      </span>
    </a>

    <!-- Desktop navigation -->
    <nav aria-label="Primary" class="hidden sm:block">
      <ul class="flex items-center gap-0.5">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="relative rounded-full px-3 py-1.5 text-sm font-medium text-ink-soft transition-colors duration-200 hover:text-ink aria-[current=page]:text-ink"
              >
                {item.label}
                {isActive(item.href) && (
                  <span class="absolute inset-x-3 -bottom-0.5 h-0.5 rounded-full bg-[var(--accent)]" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile navigation: a no-JS disclosure menu -->
    <details class="menu relative sm:hidden">
      <summary
        class="grid h-11 w-11 cursor-pointer place-items-center rounded-full border-2 border-ink text-ink"
        aria-label="Menu"
      >
        <svg
          class="menu__open h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          class="menu__close h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <ul
        class="absolute right-0 top-[calc(100%+0.65rem)] w-52 rounded-2xl border-2 border-ink bg-paper p-2 shadow-[var(--shadow-lift-2)]"
      >
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="block rounded-xl px-3.5 py-3 text-sm font-semibold text-ink-soft transition-colors duration-150 hover:bg-sand-deep aria-[current=page]:bg-[var(--accent)] aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</header>

<style>
  .menu summary {
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu .menu__close {
    display: none;
  }
  .menu[open] .menu__open {
    display: none;
  }
  .menu[open] .menu__close {
    display: block;
  }
</style>
