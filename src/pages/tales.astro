---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TaleCard from '../components/TaleCard.astro';
import Doodle from '../components/Doodle.astro';

const towels = (await getCollection('towels')).sort(
  (a, b) => b.data.madeDate.getTime() - a.data.madeDate.getTime(),
);
---

<BaseLayout
  title="The Tales"
  description="Every towel XUGA has rescued, and the piece it became."
>
  <section class="relative overflow-hidden px-5 pt-16 pb-8 sm:pt-20">
    <span
      class="pointer-events-none absolute -top-2 right-[5%] hidden h-28 w-28 rotate-[10deg] text-sun sm:block"
      aria-hidden="true"
    >
      <Doodle name="sun" class="h-full w-full" />
    </span>
    <div class="relative mx-auto max-w-5xl">
      <p
        data-reveal
        class="font-hand text-2xl text-[var(--accent-ink)]"
      >
        Every tale, so far
      </p>
      <h1
        data-reveal
        style="--reveal-delay:0.08s"
        class="mt-1 font-display text-4xl text-ink sm:text-5xl"
      >
        The Tales
        <span
          class="ml-2 inline-block -translate-y-1 rotate-[-4deg] rounded-full border-[2.5px] border-ink bg-[var(--accent)] px-3 py-0.5 align-middle font-hand text-xl leading-none text-ink shadow-[3px_3px_0_var(--color-ink)]"
        >
          {towels.length}
        </span>
      </h1>
      <p
        data-reveal
        style="--reveal-delay:0.14s"
        class="mt-4 max-w-lg text-lg text-ink-soft"
      >
        {towels.length} towels rescued and resewn. Each card opens the towel's
        own account of where it has been.
      </p>
    </div>
  </section>

  <section class="px-5 pb-8">
    <div
      class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {towels.map((entry, i) => (
        <div data-reveal style={`--reveal-delay:${0.05 * i}s`}>
          <TaleCard entry={entry} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
