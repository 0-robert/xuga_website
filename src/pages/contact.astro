---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import WaveEdge from '../components/WaveEdge.astro';
import { SITE } from '../lib/site';
import type { DoodleName } from '../lib/doodles';

const channels: {
  doodle: DoodleName;
  swatch: string;
  label: string;
  value: string;
  note: string;
  href?: string;
}[] = [
  {
    doodle: 'flower',
    swatch: 'bg-shell',
    label: 'Instagram',
    value: SITE.instagram.handle,
    note: 'New pieces, the fastest way to ask what is in stock, and where we will be next.',
    href: SITE.instagram.url,
  },
  {
    doodle: 'wave',
    swatch: 'bg-sea',
    label: 'Email',
    value: SITE.email,
    note: 'For commissions, longer questions, or sending us a towel with a story.',
    href: `mailto:${SITE.email}`,
  },
  {
    doodle: 'sun',
    swatch: 'bg-sun',
    label: 'At the markets',
    value: `${SITE.place} · pop-ups`,
    note: 'We sell in person at island markets. Watch Instagram for the next date and stall.',
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with XUGA — a student-led island-wear brand in Malta upcycling beach towels into one-of-a-kind clothing."
>
  <!-- Intro -->
  <section class="relative overflow-hidden px-5 pt-16 pb-10 sm:pt-20">
    <span
      class="pointer-events-none absolute top-6 right-[5%] hidden h-24 w-24 rotate-[14deg] text-sea sm:block"
      aria-hidden="true"
    >
      <Doodle name="wave" class="h-full w-full" />
    </span>
    <div class="mx-auto max-w-3xl">
      <p
        class="flex items-center gap-2 font-hand text-2xl text-[var(--accent)]"
        data-reveal
      >
        <Doodle name="starfish" class="h-7 w-7" />
        Come and find us
      </p>
      <h1
        class="mt-1 font-display text-[2.6rem] leading-[1.04] text-ink sm:text-6xl"
        data-reveal
        style="--reveal-delay:0.08s"
      >
        Say hello.
      </h1>
      <p
        class="mt-5 max-w-xl text-lg text-ink-soft"
        data-reveal
        style="--reveal-delay:0.14s"
      >
        XUGA is a small, student-led island-wear brand in {SITE.place}. A real
        person reads every message. Whether you want a piece, have a question,
        or just want to say something kind, we would love to hear it.
      </p>
    </div>
  </section>

  <!-- Channels -->
  <section class="px-5 py-8">
    <div class="mx-auto grid max-w-5xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        channels.map((c, i) => {
          const inner = (
            <>
              <span
                class={`grid h-12 w-12 place-items-center rounded-full border-2 border-ink ${c.swatch} text-ink`}
              >
                <Doodle name={c.doodle} class="h-6 w-6" />
              </span>
              <h2 class="mt-4 font-display text-2xl text-ink">{c.label}</h2>
              <p class="mt-1 font-hand text-2xl text-[var(--accent)]">
                {c.value}
              </p>
              <p class="mt-2 text-ink-soft">{c.note}</p>
            </>
          );
          const base =
            'flex flex-col rounded-2xl border-[2.5px] border-ink bg-paper p-6 shadow-[4px_4px_0_var(--color-ink)]';
          return c.href ? (
            <a
              href={c.href}
              data-reveal
              style={`--reveal-delay:${0.07 * i}s`}
              class={`${base} transition-transform duration-200 ease-soft hover:-translate-y-1`}
            >
              {inner}
            </a>
          ) : (
            <div
              data-reveal
              style={`--reveal-delay:${0.07 * i}s`}
              class={base}
            >
              {inner}
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- Commission -->
  <section class="relative overflow-hidden bg-ink px-5 py-20 text-sand sm:py-24">
    <WaveEdge color="var(--color-sand)" />
    <span
      class="pointer-events-none absolute top-10 left-[8%] hidden h-16 w-16 rotate-[-12deg] text-sun/70 sm:block"
      aria-hidden="true"
    >
      <Doodle name="sparkle" class="h-full w-full" />
    </span>
    <span
      class="pointer-events-none absolute right-[9%] bottom-10 hidden h-20 w-20 rotate-[10deg] text-sea/70 sm:block"
      aria-hidden="true"
    >
      <Doodle name="shell" class="h-full w-full" />
    </span>
    <div class="relative mx-auto max-w-2xl text-center">
      <p class="font-hand text-2xl text-sun" data-reveal>
        Got a towel with a story?
      </p>
      <h2
        class="mt-1 font-display text-3xl sm:text-4xl"
        data-reveal
        style="--reveal-delay:0.08s"
      >
        We will turn it into something you keep.
      </h2>
      <p
        class="mx-auto mt-3 max-w-md text-sand/70"
        data-reveal
        style="--reveal-delay:0.14s"
      >
        Send us the towel from a childhood summer, an old hotel, a holiday you
        still think about. We will sew it into a piece and write its tale, so
        the memory comes with it.
      </p>
      <a
        href={`mailto:${SITE.email}?subject=A%20towel%20with%20a%20story`}
        class="mt-7 inline-block rounded-full bg-[var(--accent)] px-7 py-3 text-sm font-semibold text-ink shadow-[3px_3px_0_var(--color-sand)] transition-transform duration-200 ease-soft hover:scale-[1.03]"
        data-reveal
        style="--reveal-delay:0.2s"
      >
        Email us about a commission
      </a>
    </div>
  </section>
</BaseLayout>
