---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveEdge from '../components/WaveEdge.astro';
import Doodle from '../components/Doodle.astro';
import { SITE } from '../lib/site';

const page = (await getEntry('pages', 'about'))!.data;
const sections = page.sections ?? [];

// Decide the WaveEdge color above a section based on whether the previous
// section was sand or sand-deep, so transitions stay seamless even when
// editors re-order or add new sections through the CMS.
const tones: ('sand' | 'sand-deep')[] = ['sand'];
sections.forEach((s) => tones.push(s.tone));
---

<BaseLayout
  title="About"
  description="XUGA gives worn-out beach towels a second life as island wear, and a voice through Towel Tales."
>
  <section class="relative overflow-hidden px-5 pt-16 pb-10 sm:pt-20">
    <span
      class="pointer-events-none absolute -top-3 right-[5%] hidden h-28 w-28 rotate-[-10deg] text-shell sm:block"
      aria-hidden="true"
    >
      <Doodle name="flower" class="h-full w-full" />
    </span>
    <div class="relative mx-auto max-w-3xl">
      <p data-reveal class="font-hand text-2xl text-[var(--accent-ink)]">
        {page.introEyebrow}
      </p>
      <h1
        data-reveal
        style="--reveal-delay:0.08s"
        class="mt-1 font-display text-4xl leading-tight text-ink sm:text-5xl"
      >
        {page.introHeading}
      </h1>
    </div>
  </section>

  {
    sections.map((section, i) => {
      const prevTone = tones[i];
      const tone = section.tone;
      const isDeep = tone === 'sand-deep';
      const needsWave = prevTone !== tone;
      const waveColor =
        prevTone === 'sand' ? 'var(--color-sand)' : 'var(--color-sand-deep)';
      const bg = isDeep
        ? 'grain-layer bg-sand-deep'
        : '';
      return (
        <section class={`relative overflow-hidden px-5 py-14 ${bg}`}>
          {needsWave && <WaveEdge color={waveColor} />}
          <div class="relative mx-auto max-w-3xl space-y-5 text-lg leading-relaxed text-ink">
            <h2 data-reveal class="font-display text-2xl text-ink">
              {section.heading}
            </h2>
            {section.paragraphs.map((p, j) => (
              <p data-reveal style={`--reveal-delay:${0.08 + 0.06 * j}s`}>
                {p}
              </p>
            ))}
          </div>
        </section>
      );
    })
  }

  <section class="grain-layer relative overflow-hidden bg-ink px-5 py-16 text-sand">
    <WaveEdge color={tones[tones.length - 1] === 'sand' ? 'var(--color-sand)' : 'var(--color-sand-deep)'} />
    <div class="relative mx-auto max-w-3xl">
      <h2 data-reveal class="font-display text-2xl">{page.helloHeading}</h2>
      <p data-reveal style="--reveal-delay:0.08s" class="mt-3 max-w-md text-sand/70">
        {page.helloBody}
      </p>
      <ul data-reveal style="--reveal-delay:0.14s" class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sand">
        <li>
          <a
            class="underline-offset-4 hover:underline"
            href={SITE.instagram.url}>Instagram {SITE.instagram.handle}</a
          >
        </li>
        <li>
          <a
            class="underline-offset-4 hover:underline"
            href={`mailto:${SITE.email}`}>{SITE.email}</a
          >
        </li>
        <li>
          <a class="underline-offset-4 hover:underline" href="/contact/"
            >Get in touch</a
          >
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
