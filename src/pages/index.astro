---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TaleCard from '../components/TaleCard.astro';
import Doodle from '../components/Doodle.astro';
import WaveEdge from '../components/WaveEdge.astro';
import type { DoodleName } from '../lib/doodles';
import { SITE } from '../lib/site';
import heroArt from '../assets/hero-home.png';
import heroWide from '../assets/hero-wide.png';

const towels = await getCollection('towels');
const featured = towels.filter((t) => t.data.featured);

const steps: { title: string; body: string; doodle: DoodleName }[] = [
  {
    title: 'You find a piece you love',
    body: 'Each one is sewn by hand from a single retired beach towel. No two are alike, because no two towels are.',
    doodle: 'shell',
  },
  {
    title: 'It carries a small tag',
    body: 'Sewn into every garment is a fabric tag with a code, the kind that brought you to this page.',
    doodle: 'sparkle',
  },
  {
    title: 'The towel tells its tale',
    body: 'Scan it and you meet the towel: where it spent its summers, who rescued it, and what it became.',
    doodle: 'sun',
  },
];
---

<BaseLayout title={SITE.name}>
  <!-- Hero -->
  <section class="home-hero relative overflow-hidden">
    <!-- Text: in flow above the art on small screens, overlaid on it from lg up -->
    <div class="relative z-10 lg:absolute lg:inset-0 lg:flex lg:items-center">
      <div class="mx-auto w-full max-w-6xl px-5 py-9 lg:py-8">
        <div class="max-w-md lg:max-w-[30rem]">
          <p
            data-reveal
            class="flex items-center gap-2 font-hand text-2xl text-[var(--accent)]"
          >
            <Doodle name="sun" class="h-7 w-7" />
            XUGA &middot; Island Wear Anywhere
          </p>
          <h1
            data-reveal
            style="--reveal-delay:0.08s"
            class="mt-1 font-display text-[2.4rem] leading-[1.05] text-ink sm:text-[3rem] lg:text-[3.1rem]"
          >
            Our island wear started life as a beach towel.
          </h1>
          <p
            data-reveal
            style="--reveal-delay:0.16s"
            class="mt-5 text-lg text-ink-soft"
          >
            XUGA up-cycles retired beach towels into island wear made to last. 
            Every piece is unique, just like you!
          </p>
          <div
            data-reveal
            style="--reveal-delay:0.24s"
            class="mt-8 flex flex-wrap gap-3"
          >
            <a
              href="/tales/"
              class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-sand transition-transform duration-200 ease-soft hover:scale-[1.03]"
            >
              Read the tales
            </a>
            <a
              href="#how"
              class="rounded-full border-2 border-ink px-6 py-3 text-sm font-semibold text-ink transition-colors duration-200 hover:bg-ink/5"
            >
              How it works
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- The towel character on a beach. Wide crop overlaid on desktop,
         taller crop stacked below the text on small screens. -->
    <Image
      src={heroWide}
      alt="A XUGA bucket hat on a stack of folded dolphin-print beach towels, with a friendly pair of eyes peeking out, on a sunny beach"
      widths={[1200, 1800, 2386]}
      sizes="100vw"
      class="home-hero__wide"
      loading="eager"
    />
    <Image
      src={heroArt}
      alt=""
      widths={[480, 768, 1100]}
      sizes="100vw"
      class="home-hero__tall"
      loading="eager"
    />
  </section>

  <style>
    .home-hero {
      background: #faeddf;
    }
    .home-hero__wide {
      display: none;
    }
    .home-hero__tall {
      display: block;
      width: 100%;
      height: auto;
    }
    @media (min-width: 1024px) {
      .home-hero {
        min-height: clamp(31rem, 43vw, 40rem);
      }
      .home-hero__wide {
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: right center;
      }
      .home-hero__tall {
        display: none;
      }
    }
  </style>

  <!-- How it works -->
  <section id="how" class="relative overflow-hidden bg-sand-deep px-5 py-20 sm:py-24">
    <WaveEdge color="var(--color-sand)" />
    <span
      class="pointer-events-none absolute -right-6 top-8 hidden h-28 w-28 rotate-[8deg] text-shell sm:block"
      aria-hidden="true"
    >
      <Doodle name="flower" class="h-full w-full" />
    </span>
    <div class="relative mx-auto max-w-5xl">
      <h2 class="font-display text-3xl text-ink sm:text-4xl">
        How a tale works
      </h2>
      <ol class="mt-10 grid gap-10 sm:grid-cols-3">
        {
          steps.map((step, i) => (
            <li>
              <div class="flex items-center gap-3">
                <span class="font-display text-5xl font-semibold text-[var(--accent)]">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="h-10 w-10 text-ink">
                  <Doodle name={step.doodle} class="h-full w-full" />
                </span>
              </div>
              <h3 class="mt-3 font-display text-xl text-ink">{step.title}</h3>
              <p class="mt-2 text-ink-soft">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Meet the towels -->
  <section class="px-5 py-20 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <p class="flex items-center gap-2 font-hand text-2xl text-[var(--accent)]">
        <Doodle name="starfish" class="h-7 w-7" />
        Three second lives
      </p>
      <h2 class="mt-1 font-display text-3xl text-ink sm:text-4xl">
        Meet the towels
      </h2>
      <p class="mt-3 max-w-md text-ink-soft">
        Three towels, three second lives. Pick one and hear it out.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((entry) => <TaleCard entry={entry} />)}
      </div>
      <a
        href="/gallery/"
        class="group mt-9 inline-flex items-center gap-2 text-sm font-semibold text-[var(--accent)]"
      >
        See the whole collection
        <span
          class="inline-block transition-transform duration-300 ease-soft group-hover:translate-x-1"
          aria-hidden="true">&rarr;</span
        >
      </a>
    </div>
  </section>

  <!-- Closing -->
  <section class="relative overflow-hidden bg-ink px-5 py-20 text-sand sm:py-24">
    <WaveEdge color="var(--color-sand)" />
    <span
      class="pointer-events-none absolute left-[8%] top-10 hidden h-16 w-16 rotate-[-12deg] text-sun/70 sm:block"
      aria-hidden="true"
    >
      <Doodle name="sparkle" class="h-full w-full" />
    </span>
    <span
      class="pointer-events-none absolute bottom-10 right-[10%] hidden h-20 w-20 rotate-[10deg] text-sea/70 sm:block"
      aria-hidden="true"
    >
      <Doodle name="shell" class="h-full w-full" />
    </span>
    <div class="relative mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl sm:text-4xl">
        Ready to find your own?
      </h2>
      <p class="mx-auto mt-3 max-w-md text-sand/70">
        Each XUGA piece is one of one. When you buy it, the tale becomes
        yours to carry.
      </p>
      <a
        href="/gallery/"
        class="mt-7 inline-block rounded-full bg-[var(--accent)] px-7 py-3 text-sm font-semibold text-ink shadow-[3px_3px_0_var(--color-sand)] transition-transform duration-200 ease-soft hover:scale-[1.03]"
      >
        See the collection
      </a>
    </div>
  </section>
</BaseLayout>
