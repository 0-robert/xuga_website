---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TaleCard from '../components/TaleCard.astro';
import Doodle from '../components/Doodle.astro';
import WaveEdge from '../components/WaveEdge.astro';
import { SITE } from '../lib/site';
import heroArt from '../assets/hero-home.png';
import heroWide from '../assets/hero-wide.png';

const towels = await getCollection('towels');
const featured = towels.filter((t) => t.data.featured);

const page = (await getEntry('pages', 'home'))!.data;
const team = page.teamMembers ?? [];
---

<BaseLayout title={SITE.name}>
  <!-- Hero -->
  <section class="home-hero relative overflow-hidden">
    <!-- Text: in flow above the art on small screens, overlaid on it from lg up -->
    <div class="relative z-10 lg:absolute lg:inset-0 lg:flex lg:items-center">
      <div class="mx-auto w-full max-w-6xl px-5 py-9 lg:py-8">
        <div class="max-w-md lg:max-w-[30rem]">
          <p
            data-reveal
            class="flex items-center gap-2 font-hand text-2xl text-[var(--accent-ink)]"
          >
            <Doodle name="sun" class="h-7 w-7" />
            {page.heroEyebrow}
          </p>
          <h1
            data-reveal
            style="--reveal-delay:0.08s"
            class="mt-1 font-display text-[2.4rem] leading-[1.05] text-ink sm:text-[3rem] lg:text-[3.1rem]"
          >
            {page.heroHeading}
          </h1>
          <p
            data-reveal
            style="--reveal-delay:0.16s"
            class="mt-5 text-lg text-ink-soft"
          >
            {page.heroBody}
          </p>
          <div
            data-reveal
            style="--reveal-delay:0.24s"
            class="mt-8 flex flex-wrap gap-3"
          >
            <a href={page.ctaPrimaryHref} class="chip chip--sun">
              <span class="chip__icon">
                <Doodle name="shell" class="h-4 w-4" />
              </span>
              {page.ctaPrimaryLabel}
            </a>
            <a href={page.ctaSecondaryHref} class="chip chip--shell">
              <span class="chip__icon">
                <Doodle name="sparkle" class="h-4 w-4" />
              </span>
              {page.ctaSecondaryLabel}
            </a>
          </div>
        </div>
      </div>
    </div>

    <Image
      src={heroWide}
      alt="A XUGA bucket hat on a stack of folded dolphin-print beach towels, with a friendly pair of eyes peeking out, on a sunny beach"
      widths={[1200, 1800, 2386]}
      sizes="100vw"
      class="home-hero__wide"
      loading="eager"
    />
    <Image
      src={heroArt}
      alt=""
      widths={[480, 768, 1100]}
      sizes="100vw"
      class="home-hero__tall"
      loading="eager"
    />
  </section>

  <style>
    .home-hero {
      background: #faeddf;
    }
    .home-hero__wide {
      display: none;
    }
    .home-hero__tall {
      display: block;
      width: 100%;
      height: auto;
    }
    @media (min-width: 1024px) {
      .home-hero {
        min-height: clamp(31rem, 43vw, 40rem);
      }
      .home-hero__wide {
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: right center;
      }
      .home-hero__tall {
        display: none;
      }
    }
  </style>

  <!-- Product first: what we are making right now -->
  <section class="grain-layer relative overflow-hidden bg-sand-deep px-5 py-20 sm:py-24">
    <WaveEdge color="var(--color-sand)" />
    <span
      class="pointer-events-none absolute -right-6 top-8 hidden h-28 w-28 rotate-[8deg] text-shell sm:block"
      aria-hidden="true"
    >
      <Doodle name="flower" class="h-full w-full" />
    </span>
    <div class="relative mx-auto max-w-5xl">
      <p
        data-reveal
        class="flex items-center gap-2 font-hand text-2xl text-[var(--accent-ink)]"
      >
        <Doodle name="starfish" class="h-7 w-7" />
        {page.meetEyebrow}
      </p>
      <h2
        data-reveal
        style="--reveal-delay:0.08s"
        class="mt-1 font-display text-3xl text-ink sm:text-4xl"
      >
        {page.meetHeading}
      </h2>
      <p
        data-reveal
        style="--reveal-delay:0.14s"
        class="mt-3 max-w-md text-ink-soft"
      >
        {page.meetBody}
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((entry, i) => (
          <div data-reveal style={`--reveal-delay:${0.08 + 0.07 * i}s`}>
            <TaleCard entry={entry} />
          </div>
        ))}
      </div>
      <a
        href={page.meetMoreHref}
        data-reveal
        style="--reveal-delay:0.28s"
        class="group mt-9 -ml-3 inline-flex min-h-11 items-center gap-2 rounded-full px-3 py-2.5 text-sm font-semibold text-[var(--accent-ink)] hover:bg-ink/5"
      >
        {page.meetMoreLabel}
        <span
          class="inline-block transition-transform duration-300 ease-soft group-hover:translate-x-1"
          aria-hidden="true">&rarr;</span
        >
      </a>
    </div>
  </section>

  <!-- The team -->
  <section
    id="team"
    class="relative overflow-hidden px-5 py-20 sm:py-24"
  >
    <WaveEdge color="var(--color-sand-deep)" />
    <span
      class="pointer-events-none absolute -top-2 left-[5%] hidden h-24 w-24 rotate-[-12deg] text-sun sm:block"
      aria-hidden="true"
    >
      <Doodle name="sun" class="h-full w-full" />
    </span>
    <div class="relative mx-auto max-w-5xl">
      <p
        data-reveal
        class="flex items-center gap-2 font-hand text-2xl text-[var(--accent-ink)]"
      >
        <Doodle name="sprout" class="h-7 w-7" />
        {page.teamEyebrow}
      </p>
      <h2
        data-reveal
        style="--reveal-delay:0.08s"
        class="mt-1 font-display text-3xl text-ink sm:text-4xl"
      >
        {page.teamHeading}
      </h2>
      <p
        data-reveal
        style="--reveal-delay:0.14s"
        class="mt-3 max-w-md text-ink-soft"
      >
        {page.teamBody}
      </p>

      <ul
        class="mt-10 grid grid-cols-2 gap-x-5 gap-y-9 sm:grid-cols-3 lg:grid-cols-4"
      >
        {
          team.map((member, i) => {
            // Subtle alternating tilt so the row reads as hand-pinned polaroids
            // rather than a rigid grid. Reset on hover for legibility.
            const tilt = i % 2 === 0 ? '-1.2deg' : '1.4deg';
            return (
              <li
                class="team-card"
                data-reveal
                style={`--reveal-delay:${0.05 + 0.04 * i}s; --tilt:${tilt}`}
              >
                <div class="team-card__frame">
                  <img
                    src={member.photo}
                    alt={`${member.name}, ${member.role}`}
                    width="320"
                    height="320"
                    loading="lazy"
                    class="team-card__photo"
                  />
                </div>
                <p class="team-card__name">{member.name}</p>
                <p class="team-card__role">{member.role}</p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- Closing -->
  <section class="grain-layer relative overflow-hidden bg-ink px-5 py-20 text-sand sm:py-24">
    <WaveEdge color="var(--color-sand)" />
    <span
      class="pointer-events-none absolute left-[8%] top-10 hidden h-16 w-16 rotate-[-12deg] text-sun/70 sm:block"
      aria-hidden="true"
    >
      <Doodle name="sparkle" class="h-full w-full" />
    </span>
    <span
      class="pointer-events-none absolute bottom-10 right-[10%] hidden h-20 w-20 rotate-[10deg] text-sea/70 sm:block"
      aria-hidden="true"
    >
      <Doodle name="shell" class="h-full w-full" />
    </span>
    <div class="relative mx-auto max-w-3xl text-center">
      <h2 data-reveal class="font-display text-3xl sm:text-4xl">
        {page.closingHeading}
      </h2>
      <p
        data-reveal
        style="--reveal-delay:0.08s"
        class="mx-auto mt-3 max-w-md text-sand/70"
      >
        {page.closingBody}
      </p>
      <a
        href={page.closingCtaHref}
        data-reveal
        style="--reveal-delay:0.16s"
        class="mt-7 inline-block rounded-full bg-[var(--accent)] px-7 py-3 text-sm font-semibold text-ink shadow-[3px_3px_0_var(--color-sand)] transition-transform duration-200 ease-soft hover:scale-[1.03] active:scale-[0.97]"
      >
        {page.closingCtaLabel}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .team-card {
    text-align: center;
    rotate: var(--tilt, 0deg);
    transition:
      rotate 0.3s var(--ease-soft),
      translate 0.3s var(--ease-soft);
  }
  .team-card:hover {
    rotate: 0deg;
    translate: 0 -3px;
  }
  .team-card__frame {
    overflow: hidden;
    border: 3px solid var(--color-paper);
    border-radius: 20px;
    background: var(--color-paper);
    box-shadow: var(--shadow-lift-2);
    aspect-ratio: 1 / 1;
  }
  .team-card__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .team-card__name {
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.1;
    color: var(--color-ink);
  }
  .team-card__role {
    margin-top: 0.15rem;
    font-size: 0.92rem;
    color: var(--color-ink-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .team-card { rotate: 0deg; transition: none; }
  }
</style>
