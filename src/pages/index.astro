---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TaleCard from '../components/TaleCard.astro';
import Doodle from '../components/Doodle.astro';
import WaveEdge from '../components/WaveEdge.astro';
import { SITE } from '../lib/site';
import heroArt from '../assets/hero-home.png';
import heroWide from '../assets/hero-wide.png';

const towels = await getCollection('towels');
const featured = towels.filter((t) => t.data.featured);

const page = (await getEntry('pages', 'home'))!.data;
const team = page.teamMembers ?? [];
---

<BaseLayout title={SITE.name}>
  <!-- Hero -->
  <section class="home-hero relative overflow-hidden">
    <!-- Text: in flow above the art on small screens, overlaid on it from lg up -->
    <div class="relative z-10 lg:absolute lg:inset-0 lg:flex lg:items-center">
      <div class="mx-auto w-full max-w-6xl px-5 py-9 lg:py-8">
        <div class="max-w-md lg:max-w-[30rem]">
          <p
            data-reveal
            class="flex items-center gap-2 font-hand text-2xl text-[var(--accent-ink)]"
          >
            <Doodle name="sun" class="h-7 w-7" />
            {page.heroEyebrow}
          </p>
          <h1
            data-reveal
            style="--reveal-delay:0.08s"
            class="mt-1 font-display text-[2.4rem] leading-[1.05] text-ink sm:text-[3rem] lg:text-[3.1rem]"
          >
            {page.heroHeading}
          </h1>
          <p
            data-reveal
            style="--reveal-delay:0.16s"
            class="mt-5 text-lg text-ink-soft"
          >
            {page.heroBody}
          </p>
          <div
            data-reveal
            style="--reveal-delay:0.24s"
            class="mt-8 flex flex-wrap gap-3"
          >
            <a href={page.ctaPrimaryHref} class="chip chip--sun">
              <span class="chip__icon">
                <Doodle name="shell" class="h-4 w-4" />
              </span>
              {page.ctaPrimaryLabel}
            </a>
            <a href={page.ctaSecondaryHref} class="chip chip--shell">
              <span class="chip__icon">
                <Doodle name="sparkle" class="h-4 w-4" />
              </span>
              {page.ctaSecondaryLabel}
            </a>
          </div>
          <p
            data-reveal
            style="--reveal-delay:0.32s"
            class="mt-4 font-hand text-xl text-[var(--accent-ink)]"
          >
            <a
              class="inline-flex items-center gap-1 underline-offset-4 hover:underline focus-visible:underline"
              href="/anywhere/"
            >
              See where it's been
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </div>
    </div>

    <Image
      src={heroWide}
      alt="A XUGA bucket hat on a stack of folded dolphin-print beach towels, with a friendly pair of eyes peeking out, on a sunny beach"
      widths={[1200, 1800, 2386]}
      sizes="100vw"
      class="home-hero__wide"
      loading="eager"
    />
    <Image
      src={heroArt}
      alt=""
      widths={[480, 768, 1100]}
      sizes="100vw"
      class="home-hero__tall"
      loading="eager"
    />
  </section>

  <style>
    .home-hero {
      /* Was a hardcoded #faeddf; switched to the brand sand token so the
         hero blends seamlessly into the WaveEdge sand-colour at the top
         of the section below (otherwise the seam shows as a thin band). */
      background: var(--color-sand);
    }
    .home-hero__wide {
      display: none;
    }
    .home-hero__tall {
      display: block;
      width: 100%;
      height: auto;
    }
    @media (min-width: 1024px) {
      .home-hero {
        min-height: clamp(31rem, 43vw, 40rem);
      }
      .home-hero__wide {
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: right center;
      }
      .home-hero__tall {
        display: none;
      }
    }
  </style>

  <!-- Product first: what we are making right now -->
  <section class="grain-layer relative overflow-hidden bg-sand-deep px-5 pt-32 pb-20 sm:pt-36 sm:pb-24">
    <!-- Three-band wave transition (same pattern as the team -> closing
         transition, scaled down for the milder colour shift between sand
         and sand-deep). Each band drifts on its own period so the seam
         reads as moving water, not a stripe. -->
    <span class="product-waves" aria-hidden="true">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path class="wave-layer wave-layer--sand"
              d="M-50 22 Q90 8 230 22 T510 22 T790 22 T1070 22 T1250 22 L1250 140 L-50 140 Z" />
        <path class="wave-layer wave-layer--blend"
              d="M-50 52 Q110 38 270 52 T590 52 T910 52 T1250 52 L1250 140 L-50 140 Z" />
        <path class="wave-layer wave-layer--sand-deep"
              d="M-50 84 Q80 70 210 84 T470 84 T730 84 T990 84 T1250 84 L1250 140 L-50 140 Z" />
      </svg>
    </span>
    <span
      class="pointer-events-none absolute -right-6 top-32 hidden h-28 w-28 rotate-[8deg] text-shell sm:block"
      aria-hidden="true"
    >
      <Doodle name="flower" class="h-full w-full" />
    </span>
    <div class="relative z-10 mx-auto max-w-5xl text-center">
      <p
        data-reveal
        class="inline-flex items-center gap-2 font-hand text-2xl text-[var(--accent-ink)]"
      >
        <Doodle name="starfish" class="h-7 w-7" />
        {page.meetEyebrow}
      </p>
      <h2
        data-reveal
        style="--reveal-delay:0.08s"
        class="mt-1 font-display text-3xl text-ink sm:text-4xl"
      >
        {page.meetHeading}
      </h2>
      <p
        data-reveal
        style="--reveal-delay:0.14s"
        class="mx-auto mt-3 max-w-md text-ink-soft"
      >
        {page.meetBody}
      </p>
      <div class="mt-10 grid gap-6 text-left sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((entry, i) => (
          <div data-reveal style={`--reveal-delay:${0.08 + 0.07 * i}s`}>
            <TaleCard entry={entry} />
          </div>
        ))}
      </div>
      <a
        href={page.meetMoreHref}
        data-reveal
        style="--reveal-delay:0.28s"
        class="group mt-9 inline-flex min-h-11 items-center gap-2 rounded-full px-3 py-2.5 text-sm font-semibold text-[var(--accent-ink)] hover:bg-ink/5"
      >
        {page.meetMoreLabel}
        <span
          class="inline-block transition-transform duration-300 ease-soft group-hover:translate-x-1"
          aria-hidden="true">&rarr;</span
        >
      </a>
    </div>
  </section>

  <!-- The team -->
  <section
    id="team"
    class="team-section relative overflow-hidden px-5 pt-20 pb-32 sm:pt-24 sm:pb-40"
  >
    <WaveEdge color="var(--color-sand-deep)" />
    <!-- Stylised beach scene behind the polaroids. The image is bottom-
         anchored, fades into the sand at the top, and sits below the
         content stack via z-index. -->
    <div class="team-beach" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-5xl text-center">
      <p
        data-reveal
        class="inline-flex items-center gap-2 font-hand text-2xl text-[var(--accent-ink)]"
      >
        <Doodle name="sprout" class="h-7 w-7" />
        {page.teamEyebrow}
      </p>
      <h2
        data-reveal
        style="--reveal-delay:0.08s"
        class="mt-1 font-display text-3xl text-ink sm:text-4xl"
      >
        {page.teamHeading}
      </h2>
      <p
        data-reveal
        style="--reveal-delay:0.14s"
        class="mx-auto mt-3 max-w-md text-ink-soft"
      >
        {page.teamBody}
      </p>

      <ul class="team-grid mt-12">
        {
          team.map((member, i) => {
            // Pinned-polaroid feel: each card gets its own tilt, sway timing,
            // and washi-tape colour so the row reads as hand-arranged rather
            // than a rigid grid. Values are deterministic per index so the
            // composition is consistent across builds.
            const tilts = [-5.0, 4.2, -2.6, 4.6, -3.4, 2.4, -4.2];
            const tapes = ['sun', 'shell', 'sea', 'lime', 'shell', 'sun', 'sea'];
            const swayDelay = (i * 0.55).toFixed(2);
            const swayDur = (4.4 + (i % 3) * 0.6).toFixed(1);
            return (
              <li
                class={`team-card tape--${tapes[i % tapes.length]}`}
                data-reveal
                style={`
                  --reveal-delay:${0.05 + 0.05 * i}s;
                  --tilt:${tilts[i % tilts.length]}deg;
                  --sway-delay:${swayDelay}s;
                  --sway-duration:${swayDur}s;
                `}
              >
                <span class="team-card__tape" aria-hidden="true"></span>
                <div class="team-card__frame">
                  <img
                    src={member.photo}
                    alt={`${member.name}, ${member.role}`}
                    width="320"
                    height="320"
                    loading="lazy"
                    class="team-card__photo"
                  />
                </div>
                <p class="team-card__name">{member.name}</p>
                <p class="team-card__role">{member.role}</p>
              </li>
            );
          })
        }
      </ul>

      <p
        data-reveal
        style="--reveal-delay:0.1s"
        class="relative z-10 mt-12 text-center font-hand text-2xl text-[var(--accent-ink)] sm:mt-16 sm:text-3xl"
      >
        <a
          class="inline-flex items-center gap-2 underline-offset-4 hover:underline focus-visible:underline"
          href="/anywhere/"
        >
          See where the team has taken XUGA
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- Closing -->
  <section class="closing-section grain-layer relative bg-ink pt-52 pb-10 text-sand sm:pb-14">
    <!-- Four-layer wave transition: foam (sand) -> shallows (sea-pale)
         -> water (sea) -> deep (ink). Each layer drifts slowly on its
         own timing so the whole thing reads as moving water rather
         than a static edge. Disabled under reduced-motion.

         Painter order matters: each path fills from its wave-top down
         to the SVG bottom; subsequent (deeper) layers paint on top and
         cover the previous one's lower portion. So we go from foam at
         the back to deep ink at the front. -->
    <!-- BACK waves (foam, shallow, sea): paint BEHIND the dolphin. -->
    <span class="closing-waves closing-waves--back" aria-hidden="true">
      <svg viewBox="0 0 1200 200" preserveAspectRatio="none">
        <path class="wave-layer wave-layer--foam"
              d="M-50 28 Q80 16 210 28 T470 28 T730 28 T990 28 T1250 28 L1250 220 L-50 220 Z" />
        <path class="wave-layer wave-layer--shallow"
              d="M-50 60 Q110 44 270 60 T590 60 T910 60 T1250 60 L1250 220 L-50 220 Z" />
        <path class="wave-layer wave-layer--sea"
              d="M-50 105 Q90 84 230 105 T510 105 T790 105 T1070 105 T1250 105 L1250 220 L-50 220 Z" />
      </svg>
    </span>
    <span class="closing-dolphin" aria-hidden="true">
      <img
        class="dolphin-img"
        src="/images/dolphin.png"
        alt=""
        width="400"
        height="400"
        loading="lazy"
        decoding="async"
      />
      <!-- Splashes live INSIDE the dolphin container so their inline left/top
           percentages (from the keyframer export) resolve against the same
           box the GSAP MotionPath uses as origin. Each one is fired once by
           the timeline at the moment the dolphin's path passes nearest. -->
      <svg
        class="dolphin-splash dolphin-splash--1"
        viewBox="-80 -40 160 50"
        preserveAspectRatio="xMidYMax meet"
        aria-hidden="true"
        style="left:-112.87%; top:83.34%;"
      >
        <ellipse class="splash-ring splash-ring--outer" cx="0" cy="-2" rx="34" ry="6" />
        <ellipse class="splash-ring splash-ring--inner" cx="0" cy="-2" rx="18" ry="3.5" />
        <path class="splash-drop" d="M-6 -2 Q-9 -14 -10 -26 Q-7 -14 -4 -2 Z" />
        <path class="splash-drop" d="M6 -2 Q9 -14 10 -26 Q7 -14 4 -2 Z" />
        <path class="splash-drop" d="M-18 -2 Q-22 -10 -28 -18 Q-22 -10 -16 -2 Z" />
        <path class="splash-drop" d="M18 -2 Q22 -10 28 -18 Q22 -10 16 -2 Z" />
        <circle class="splash-pellet" cx="-30" cy="-14" r="1.6" />
        <circle class="splash-pellet" cx="30" cy="-14" r="1.6" />
        <circle class="splash-pellet" cx="-14" cy="-26" r="1.2" />
        <circle class="splash-pellet" cx="14" cy="-26" r="1.2" />
      </svg>
      <svg
        class="dolphin-splash dolphin-splash--2"
        viewBox="-80 -40 160 50"
        preserveAspectRatio="xMidYMax meet"
        aria-hidden="true"
        style="left:-22.23%; top:79.46%;"
      >
        <ellipse class="splash-ring splash-ring--outer" cx="0" cy="-2" rx="34" ry="6" />
        <ellipse class="splash-ring splash-ring--inner" cx="0" cy="-2" rx="18" ry="3.5" />
        <path class="splash-drop" d="M-6 -2 Q-9 -14 -10 -26 Q-7 -14 -4 -2 Z" />
        <path class="splash-drop" d="M6 -2 Q9 -14 10 -26 Q7 -14 4 -2 Z" />
        <path class="splash-drop" d="M-18 -2 Q-22 -10 -28 -18 Q-22 -10 -16 -2 Z" />
        <path class="splash-drop" d="M18 -2 Q22 -10 28 -18 Q22 -10 16 -2 Z" />
        <circle class="splash-pellet" cx="-30" cy="-14" r="1.6" />
        <circle class="splash-pellet" cx="30" cy="-14" r="1.6" />
        <circle class="splash-pellet" cx="-14" cy="-26" r="1.2" />
        <circle class="splash-pellet" cx="14" cy="-26" r="1.2" />
      </svg>
    </span>
    <!-- FRONT wave (ink only): paints OVER the dolphin so it dives behind dark water. -->
    <span class="closing-waves closing-waves--front" aria-hidden="true">
      <svg viewBox="0 0 1200 200" preserveAspectRatio="none">
        <path class="wave-layer wave-layer--ink"
              d="M-50 150 Q70 128 190 150 T430 150 T670 150 T910 150 T1150 150 T1250 150 L1250 220 L-50 220 Z" />
      </svg>
    </span>
    <!-- Below-water mask: extends ink colour from the wave SVG bottom all the
         way down so the dolphin is hidden anywhere below the surface. -->
    <div class="closing-below-water" aria-hidden="true"></div>
    <span
      class="pointer-events-none absolute left-[8%] top-32 hidden h-16 w-16 rotate-[-12deg] text-sun/70 sm:block"
      aria-hidden="true"
    >
      <Doodle name="sparkle" class="h-full w-full" />
    </span>
    <span
      class="pointer-events-none absolute bottom-10 right-[10%] hidden h-20 w-20 rotate-[10deg] text-sea/70 sm:block"
      aria-hidden="true"
    >
      <Doodle name="shell" class="h-full w-full" />
    </span>
    <div class="relative z-10 mx-auto max-w-3xl text-center">
      <h2 data-reveal class="font-display text-3xl sm:text-4xl">
        {page.closingHeading}
      </h2>
      <p
        data-reveal
        style="--reveal-delay:0.08s"
        class="mx-auto mt-3 max-w-md text-sand/70"
      >
        {page.closingBody}
      </p>
      <a
        href={page.closingCtaHref}
        data-reveal
        style="--reveal-delay:0.16s"
        class="mt-7 inline-block rounded-full bg-[var(--accent)] px-7 py-3 text-sm font-semibold text-ink shadow-[3px_3px_0_var(--color-sand)] transition-transform duration-200 ease-soft hover:scale-[1.03] active:scale-[0.97]"
      >
        {page.closingCtaLabel}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Layered wave transition at the top of the product section. Three
     soft bands (sand -> blend -> sand-deep) so the hero flows into the
     product band on a gradient of cream rather than meeting it on a
     single visible wave line. Same general pattern as the closing
     waves, scaled down for the milder colour shift. */
  .product-waves {
    position: absolute;
    inset: 0 0 auto 0;
    height: clamp(80px, 9vw, 120px);
    z-index: 1;
    pointer-events: none;
    line-height: 0;
    overflow: hidden;
    /* Painted area above the top wave reads as the hero's sand colour. */
    background-color: var(--color-sand);
  }
  .product-waves svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The .wave-layer drift animations (defined below for .closing-waves)
     apply here too; just supply the colour for each band. */
  .product-waves .wave-layer--sand      { fill: var(--color-sand); }
  .product-waves .wave-layer--blend {
    fill: color-mix(in oklch, var(--color-sand) 55%, var(--color-sand-deep) 45%);
  }
  .product-waves .wave-layer--sand-deep { fill: var(--color-sand-deep); }
  @media (prefers-reduced-motion: no-preference) {
    .product-waves .wave-layer--sand      { --drift-distance: 36px; animation-duration:  7s; }
    .product-waves .wave-layer--blend     { --drift-distance: 48px; animation-duration: 10s; animation-direction: reverse; }
    .product-waves .wave-layer--sand-deep { --drift-distance: 60px; animation-duration: 14s; }
  }

  /* Layered wave transition at the top of the closing section. The SVG
     fills the full width and a chunk of section height; the four paths
     stack so the eye reads beach -> wet sand -> shallow sea -> deep
     ink. Each layer drifts horizontally on a different period so the
     transition feels alive without being noisy. */
  .closing-waves {
    position: absolute;
    inset: 0 0 auto 0;
    height: clamp(140px, 16vw, 200px);
    z-index: 1;
    pointer-events: none;
    line-height: 0;
    overflow: hidden;
    /* The area above the topmost (foam) wave needs to read as the page's
       sand background, not as the closing section's ink. Painting sand
       here lets the team-section sand flow seamlessly into the foam. */
    background-color: var(--color-sand);
  }
  .closing-waves svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Layer fills. The shallows are a custom blend (sea + sand-deep) so
     the transition between foam and full sea reads as one of those
     pale-aqua shallows that fade into deeper water. */
  .wave-layer--foam    { fill: var(--color-sand); }
  .wave-layer--shallow {
    fill: color-mix(in oklch, var(--color-sea) 55%, var(--color-sand-deep) 45%);
  }
  .wave-layer--sea     { fill: var(--color-sea); }
  .wave-layer--ink     { fill: var(--color-ink); }
  /* Subtle warm-tinted shadow under the foam line for depth. */
  .wave-layer--foam {
    filter: drop-shadow(0 2px 0 oklch(0.3 0.07 256 / 0.08));
  }
  @media (prefers-reduced-motion: no-preference) {
    .wave-layer {
      animation-name: wave-drift;
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
      transform-origin: center;
    }
    /* Faster, deeper drift on the foam (closer to the eye); slower and
       wider underneath so the parallax reads. Alternating directions
       between layers makes the water look like it is folding. */
    .wave-layer--foam    {
      animation-duration: 5s;
      --drift-distance: 56px;
    }
    .wave-layer--shallow {
      animation-duration: 7s;
      animation-direction: reverse;
      --drift-distance: 72px;
    }
    .wave-layer--sea     {
      animation-duration: 9s;
      --drift-distance: 84px;
    }
    .wave-layer--ink     {
      animation-duration: 12s;
      animation-direction: reverse;
      --drift-distance: 96px;
    }
  }
  @keyframes wave-drift {
    0%, 100% { transform: translateX(calc(var(--drift-distance, 60px) * -0.5)); }
    50%      { transform: translateX(calc(var(--drift-distance, 60px) *  0.5)); }
  }

  /* The closing-waves wrapper above paints behind everything (z:1).
     The FRONT wave (ink only) paints OVER the dolphin so the dolphin
     visibly dives behind the dark surface; the below-water mask
     continues that ink colour from the wave SVG bottom all the way
     down, so anything the dolphin does deeper is hidden. */
  /* Closing section needs horizontal clipping (so wave-drift doesn't
     spill sideways) but vertical overflow visible — so the dolphin's
     apex can extend above the section line and paint over the
     team-section's beach background image. */
  .closing-section {
    overflow-x: clip;
    overflow-y: visible;
  }
  .closing-waves--back  { z-index: 1; }
  .closing-waves--front {
    z-index: 5;
    /* Same dimensions as --back; they overlap, only ink layer paints. */
    background-color: transparent;
  }
  .closing-below-water {
    position: absolute;
    /* Anchor at the bottom of the wave SVG (wave height clamps from
       140px to 200px, matching .closing-waves height). */
    top: clamp(140px, 16vw, 200px);
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-ink);
    z-index: 4;
    pointer-events: none;
  }

  /* Decorative dolphin animated by GSAP MotionPath. Sits BETWEEN the
     back waves (z:1) and the front-wave / below-water (z:4-5) so it
     visibly emerges through the surface and dives behind it. */
  .closing-dolphin {
    /* Container is anchored over the visible water line. The dolphin
       img inside is positioned absolutely; GSAP transforms it along a
       hidden SVG path. The splashes are absolutely positioned children
       whose left/top come from the keyframer export. */
    position: absolute;
    top: clamp(38px, 5.5vw, 70px);
    left: 50%;
    width: clamp(140px, 18vw, 220px);
    height: clamp(140px, 18vw, 220px);
    transform: translate(-50%, -50%);
    z-index: 3;
    pointer-events: none;
    color: var(--color-sand);
  }
  .closing-dolphin .dolphin-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    transform-origin: 50% 50%;
    filter: drop-shadow(0 8px 12px oklch(0.2 0.05 256 / 0.3));
    will-change: transform, opacity;
    /* Hidden until scroll drives the GSAP timeline. The reduced-motion
       fallback below overrides this to keep a static visible pose. */
    opacity: 0;
  }
  .closing-dolphin .dolphin-splash {
    position: absolute;
    /* left/top come from the keyframer export as inline styles. */
    width: 120%;
    height: auto;
    overflow: visible;
    transform: translate(-50%, -50%);
    pointer-events: none;
    /* GSAP fades the whole splash svg in/out at trigger time; children
       stay fully painted so the parent opacity is the only knob. */
    opacity: 0;
  }
  .closing-dolphin .splash-ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    transform-box: fill-box;
    transform-origin: center;
  }
  .closing-dolphin .splash-drop,
  .closing-dolphin .splash-pellet {
    fill: currentColor;
    transform-box: fill-box;
    transform-origin: center bottom;
  }
  @media (prefers-reduced-motion: reduce) {
    /* Hold a static dolphin pose so the section still has a focal
       point but nothing moves. GSAP is gated on no-preference, so the
       img stays untransformed; we nudge it into a pleasant rest. */
    .closing-dolphin .dolphin-img {
      transform: translateY(-20%) rotate(2deg);
      opacity: 1;
    }
    .closing-dolphin .dolphin-splash { display: none; }
  }

  /* Stylised beach scene behind the polaroids. The PNG carries its own
     transparency (the upper sky region was floodfilled to alpha=0), so
     the sand-cream page colour shows through cleanly. Pinned wide
     enough on mobile that palm trees and the sun stay anchored to the
     sides instead of squeezing into the middle. Sits at z-index 0
     below the content (z-10). */
  .team-beach {
    position: absolute;
    inset: 0;
    background-image: url('/images/team-beach.png');
    background-repeat: no-repeat;
    background-position: bottom center;
    background-size: max(100%, 1100px) auto;
    pointer-events: none;
    z-index: 0;
    opacity: 0.92;
    /* Soften the bottom edge of the beach image so its yellow-tan sand
       dissolves into the page cream instead of meeting it on a hard
       horizontal line just above the foam wave below. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 88%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 88%,
      transparent 100%
    );
  }
  @media (min-width: 1024px) {
    .team-beach {
      background-size: max(100%, 1500px) auto;
    }
  }

  /* Polaroids on a corkboard. Each card sits on its own tilt and breathes
     gently on an infinite loop, with different timings so the row looks
     hand-arranged. Hovering pulls one forward and steadies it.

     Flexbox + justify-center is deliberate: with 7 polaroids on a 4-up
     desktop grid, plain CSS Grid leaves the second row left-aligned
     (pic pic pic ___). Flex-wrap + justify-center makes the orphan row
     centre itself (__ pic pic pic __). */
  .team-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 1.5rem;
    row-gap: 3.5rem;
    padding-inline: 0.4rem;
  }
  .team-grid > .team-card {
    flex: 0 0 46%;
  }
  @media (min-width: 640px) {
    .team-grid > .team-card { flex-basis: 30%; }
  }
  @media (min-width: 1024px) {
    .team-grid {
      column-gap: 2rem;
    }
    .team-grid > .team-card { flex-basis: 21.5%; }
  }
  .team-card {
    position: relative;
    padding: 12px 12px 14px;
    background: var(--color-paper);
    border-radius: 6px;
    box-shadow:
      0 1px 2px oklch(0.3 0.07 256 / 0.10),
      0 14px 28px oklch(0.3 0.07 256 / 0.18);
    text-align: center;
    rotate: var(--tilt, 0deg);
    transform-origin: center 60%;
    transition:
      rotate 0.45s var(--ease-soft),
      scale 0.45s var(--ease-soft),
      box-shadow 0.45s var(--ease-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    .team-card {
      animation: team-sway var(--sway-duration, 6s) ease-in-out infinite;
      animation-delay: var(--sway-delay, 0s);
    }
  }
  .team-card:hover,
  .team-card:focus-within {
    rotate: 0deg;
    scale: 1.06;
    z-index: 2;
    box-shadow:
      0 2px 4px oklch(0.3 0.07 256 / 0.14),
      0 24px 44px oklch(0.3 0.07 256 / 0.26);
    animation-play-state: paused;
  }
  .team-card__tape {
    position: absolute;
    top: -10px;
    left: 50%;
    width: 64px;
    height: 18px;
    translate: -50% 0;
    rotate: -4deg;
    background: var(--tape-bg, var(--color-sun));
    /* Slight transparency + grain edge so it reads as real tape. */
    opacity: 0.82;
    box-shadow: 0 1px 0 oklch(0.3 0.07 256 / 0.05);
    /* Torn-edge effect via clip-path. */
    clip-path: polygon(
      0% 12%, 6% 0%, 14% 18%, 22% 4%, 30% 16%, 40% 2%, 50% 14%,
      60% 0%, 70% 18%, 80% 6%, 90% 14%, 100% 0%,
      100% 88%, 94% 100%, 86% 82%, 78% 96%, 70% 84%, 60% 98%, 50% 86%,
      40% 100%, 30% 82%, 20% 94%, 10% 86%, 0% 100%
    );
  }
  .team-card:nth-child(even) .team-card__tape { rotate: 5deg; }
  .tape--sun   { --tape-bg: var(--color-sun); }
  .tape--shell { --tape-bg: var(--color-shell); }
  .tape--sea   { --tape-bg: var(--color-sea); }
  .tape--lime  { --tape-bg: var(--color-lime); }

  .team-card__frame {
    overflow: hidden;
    background: var(--color-sand-deep);
    aspect-ratio: 1 / 1;
    border-radius: 2px;
  }
  .team-card__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Warm the photos a touch so they sit in the sand palette. */
    filter: saturate(1.02) contrast(1.02);
    transition: scale 0.6s var(--ease-soft);
  }
  .team-card:hover .team-card__photo {
    scale: 1.04;
  }
  .team-card__name {
    margin-top: 0.9rem;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.85rem;
    line-height: 0.95;
    color: var(--color-ink);
  }
  .team-card__role {
    margin-top: 0.15rem;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  /* Pendulum sway: rocks through ~3 degrees around the resting tilt, with
     a tiny vertical bob mid-swing. Each card has its own duration and
     delay (set inline) so the row falls out of phase. */
  @keyframes team-sway {
    0%, 100% { rotate: calc(var(--tilt, 0deg) + 1.6deg); translate: 0 0; }
    50%      { rotate: calc(var(--tilt, 0deg) - 1.6deg); translate: 0 -4px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card {
      animation: none;
      rotate: 0deg;
    }
    .team-card:hover { scale: 1; }
  }
</style>

<!-- GSAP MotionPath for the closing-section dolphin. Loaded as plain CDN
     scripts (is:inline) so they execute in order before the timeline init
     below. Total payload is small (~80kB gzip) and only on the home page. -->
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/MotionPathPlugin.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (typeof gsap === 'undefined' || typeof MotionPathPlugin === 'undefined' || typeof ScrollTrigger === 'undefined') return;

    var dolphinEl = document.querySelector('.closing-dolphin .dolphin-img');
    var section   = document.querySelector('.closing-section');
    if (!dolphinEl || !section) return;

    gsap.registerPlugin(MotionPathPlugin, ScrollTrigger);

    // Path d-attribute from the keyframer, rebased so its coords are
    // pixel offsets from the dolphin's anchor (stage centre, water line
    // y=50). The splashes live in this same anchor-relative space, so
    // path + splashes stay aligned: the dolphin actually swims through
    // the spots the keyframer placed the splashes at.
    //
    // The dolphin's initial transform at t=0 is translate(-371.66, 134.07)
    // — left & deep underwater (hidden by .closing-below-water) — matching
    // the keyframer's first control point.
    var dolphinPathD = 'M -371.66 134.07 C -370.43 127.87, -373.34 120.54, -364.30 96.84 C -355.25 73.14, -339.39 12.44, -317.37 -8.15 C -295.35 -28.74, -255.00 -33.80, -232.19 -26.70 C -209.37 -19.59, -194.99 11.88, -180.48 34.49 C -165.97 57.10, -149.68 79.50, -145.12 108.97 C -140.57 138.43, -109.59 173.06, -153.13 211.28 C -196.67 249.49, -369.95 351.11, -406.37 338.25 C -442.79 325.38, -377.44 168.10, -371.66 134.07';

    // Inject a hidden SVG holding the motion path. GSAP MotionPath
    // references it by id. We anchor the SVG at the body's top-left
    // (top:0; left:0) explicitly: with position:absolute and no offsets
    // the SVG would sit at its in-flow position (the very bottom of the
    // body), which would shift every path coordinate down by ~3000px and
    // teleport the dolphin off-screen below the page.
    if (!document.getElementById('dolphinPath')) {
      var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.style.cssText = 'position:absolute;top:0;left:0;width:0;height:0;visibility:hidden;pointer-events:none;';
      var p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      p.id = 'dolphinPath';
      p.setAttribute('d', dolphinPathD);
      svg.appendChild(p);
      document.body.appendChild(svg);
    }

    // Scroll-driven timeline: the dolphin's position is tied to scroll
    // progress through the closing section. As the user scrolls the
    // section into view, the timeline scrubs forward; scrolling back
    // reverses it. `scrub: 0.8` smooths the lag so motion feels fluid
    // rather than clamped frame-for-frame to the scroll wheel.
    var dur = 8;
    var tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        // Start once the section top has scrolled up past the lower
        // quarter of the viewport, so the user has a beat to settle on
        // the waves before the dolphin appears.
        start: 'top 75%',
        // 780px of scroll plays the full animation (1.3x the previous
        // 600). No pin — the section scrolls naturally; the dolphin's
        // timeline scrubs in step with the page motion.
        end: '+=780',
        scrub: 0.8,
      },
    });
    // No `align` / `alignOrigin`: GSAP treats path coordinates as CSS
    // translate offsets from the element's natural position, so path
    // point (0, 0) keeps the dolphin at its CSS-anchored spot and the
    // rest of the curve animates ±-relative to it.
    tl.to(dolphinEl, {
      duration: dur,
      ease: 'none',
      motionPath: {
        path: '#dolphinPath',
        autoRotate: 30,
      },
    }, 0);

    // Opacity & scale keyframed along the path (from the keyframer export).
    tl.set(dolphinEl, { opacity: 0, scale: 0.9 }, 0);
    tl.to(dolphinEl, { opacity: 0.5,         scale: 0.95,         duration: 1.0, ease: 'none' }, 0.0);
    tl.to(dolphinEl, { opacity: 0.9375,      scale: 0.99375,      duration: 1.0, ease: 'none' }, 1.0);
    tl.to(dolphinEl, { opacity: 0.96875,     scale: 0.996875,     duration: 1.0, ease: 'none' }, 2.0);
    tl.to(dolphinEl, { opacity: 0.984375,    scale: 0.9984375,    duration: 1.0, ease: 'none' }, 3.0);
    tl.to(dolphinEl, { opacity: 0.98828125,  scale: 0.998828125,  duration: 1.0, ease: 'none' }, 4.0);
    tl.to(dolphinEl, { opacity: 0.990234375, scale: 0.9990234375, duration: 1.0, ease: 'none' }, 5.0);
    tl.to(dolphinEl, { opacity: 0.9921875,   scale: 0.99921875,   duration: 1.0, ease: 'none' }, 6.0);
    // Fade the dolphin out across the final second so it's fully hidden
    // when ScrollTrigger pins the timeline at 100% past the section —
    // otherwise the head pokes above the water line when scrolled by.
    tl.to(dolphinEl, { opacity: 0, duration: 1.0, ease: 'none' }, 7.0);

    // Splash 1 (peaks at ~6.0% of cycle).
    var splash1 = document.querySelector('.closing-dolphin .dolphin-splash--1');
    if (splash1) {
      tl.set(splash1, { opacity: 0, scale: 0.4 }, 0);
      tl.to(splash1, {
        keyframes: [
          { opacity: 1, scale: 1.0, duration: 0.480 },
          { opacity: 0, scale: 1.5, duration: 0.800 },
        ],
        ease: 'power2.out',
      }, 0.480);
    }

    // Splash 2 (peaks at ~35.7% of cycle).
    var splash2 = document.querySelector('.closing-dolphin .dolphin-splash--2');
    if (splash2) {
      tl.set(splash2, { opacity: 0, scale: 0.4 }, 0);
      tl.to(splash2, {
        keyframes: [
          { opacity: 1, scale: 1.0, duration: 0.480 },
          { opacity: 0, scale: 1.5, duration: 0.800 },
        ],
        ease: 'power2.out',
      }, 2.853);
    }

    // ScrollTrigger drives playback; no manual play() needed.
  })();
</script>
