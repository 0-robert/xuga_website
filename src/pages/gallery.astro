---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
import WaveEdge from '../components/WaveEdge.astro';
import { SITE } from '../lib/site';
import type { DoodleName } from '../lib/doodles';

const pieces = (await getCollection('towels')).sort(
  (a, b) => b.data.madeDate.getTime() - a.data.madeDate.getTime(),
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

// The full XUGA range — more than the pieces currently in stock.
const range: { type: string; doodle: DoodleName; note: string }[] = [
  { type: 'Bucket hats', doodle: 'sun', note: 'Shade for long island afternoons.' },
  { type: 'Shorts', doodle: 'wave', note: 'Loose, soft, and already broken in.' },
  { type: 'Belt bags', doodle: 'shell', note: 'Hands free, phone and keys safe.' },
  { type: 'Pouches', doodle: 'starfish', note: 'For the small things you keep close.' },
  { type: 'Trousers', doodle: 'sprout', note: 'A whole towel, hip to ankle.' },
];
---

<BaseLayout
  title="Gallery"
  description="The XUGA collection: one-of-a-kind island wear, each piece sewn by hand from a single retired beach towel."
>
  <!-- Intro -->
  <section class="relative overflow-hidden px-5 pt-16 pb-10 sm:pt-20">
    <span
      class="pointer-events-none absolute -top-4 right-[4%] h-28 w-28 rotate-[-12deg] text-sun sm:h-40 sm:w-40"
      aria-hidden="true"
    >
      <Doodle name="sun" class="h-full w-full" />
    </span>
    <div class="mx-auto max-w-5xl">
      <p
        class="flex items-center gap-2 font-hand text-2xl text-[var(--accent)]"
        data-reveal
      >
        <Doodle name="shell" class="h-7 w-7" />
        Made by hand, one towel at a time
      </p>
      <h1
        class="mt-1 max-w-2xl font-display text-[2.6rem] leading-[1.04] text-ink sm:text-6xl"
        data-reveal
        style="--reveal-delay:0.08s"
      >
        The collection
      </h1>
      <p
        class="mt-5 max-w-xl text-lg text-ink-soft"
        data-reveal
        style="--reveal-delay:0.14s"
      >
        Every XUGA piece begins as a worn-out beach towel and ends as something
        you want to keep. Because no two towels are alike, no two pieces are
        either. When one is gone, it is gone.
      </p>
    </div>
  </section>

  <!-- The pieces, as editorial rows -->
  <section class="px-5 py-8">
    <div class="mx-auto flex max-w-5xl flex-col gap-20 sm:gap-28">
      {
        pieces.map((entry, i) => {
          const d = entry.data;
          const flip = i % 2 === 1;
          return (
            <article
              class="grid items-center gap-8 sm:gap-12 md:grid-cols-2"
              style={d.accent ? `--accent:${d.accent}` : undefined}
            >
              <div
                class={`relative ${flip ? 'md:order-2' : ''}`}
                data-reveal
              >
                <div class="overflow-hidden rounded-[28px] border-4 border-paper shadow-[var(--shadow-lift-3)]">
                  <Image
                    src={d.garmentPhoto}
                    alt={`${d.garmentName}, sewn from a beach towel`}
                    widths={[480, 720, 1040]}
                    sizes="(max-width: 768px) 92vw, 460px"
                    class="aspect-[5/4] w-full object-cover"
                  />
                </div>
                <span class="absolute -top-4 -right-3 rotate-[8deg] rounded-full border-[2.5px] border-ink bg-[var(--accent)] px-3.5 py-1 font-hand text-xl leading-none text-ink shadow-[3px_3px_0_var(--color-ink)]">
                  {d.editionNote}
                </span>
              </div>

              <div class={flip ? 'md:order-1' : ''} data-reveal style="--reveal-delay:0.1s">
                <p class="text-sm font-semibold tracking-[0.16em] text-ink-soft uppercase">
                  {d.garmentType}
                </p>
                <h2 class="mt-1.5 font-display text-3xl leading-tight text-ink sm:text-4xl">
                  {d.garmentName}
                </h2>
                {d.greeting && (
                  <p class="mt-3 font-hand text-2xl leading-snug text-ink-soft">
                    &ldquo;{d.greeting}&rdquo;
                  </p>
                )}
                <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-2 text-sm text-ink-soft">
                  {d.originPlace && (
                    <div>
                      <dt class="font-semibold text-ink">Towel from</dt>
                      <dd>{d.originPlace}</dd>
                    </div>
                  )}
                  <div>
                    <dt class="font-semibold text-ink">Sewn</dt>
                    <dd>{fmtDate(d.madeDate)}</dd>
                  </div>
                  {d.maker && (
                    <div>
                      <dt class="font-semibold text-ink">By</dt>
                      <dd>{d.maker}</dd>
                    </div>
                  )}
                </dl>
                <a
                  href={`/t/${entry.id}/`}
                  class="mt-7 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-semibold text-sand transition-transform duration-200 ease-soft hover:scale-[1.03] active:scale-[0.97]"
                >
                  Meet {d.towelName}, hear its tale
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- What we make -->
  <section class="grain-layer relative mt-20 overflow-hidden bg-sand-deep px-5 py-20 sm:py-24">
    <WaveEdge color="var(--color-sand)" />
    <div class="mx-auto max-w-5xl">
      <p class="font-hand text-2xl text-[var(--accent)]" data-reveal>
        The range
      </p>
      <h2
        class="mt-1 max-w-xl font-display text-3xl text-ink sm:text-4xl"
        data-reveal
        style="--reveal-delay:0.08s"
      >
        What a beach towel can become
      </h2>
      <ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          range.map((r, i) => (
            <li
              class="flex gap-4"
              data-reveal
              style={`--reveal-delay:${0.06 * i}s`}
            >
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full border-2 border-ink bg-paper text-ink">
                <Doodle name={r.doodle} class="h-6 w-6" />
              </span>
              <div>
                <h3 class="font-display text-xl text-ink">{r.type}</h3>
                <p class="mt-0.5 text-ink-soft">{r.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Closing -->
  <section class="relative overflow-hidden px-5 py-20 sm:py-24">
    <WaveEdge color="var(--color-sand-deep)" />
    <div class="relative mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl text-ink sm:text-4xl" data-reveal>
        See something you love?
      </h2>
      <p
        class="mx-auto mt-3 max-w-md text-lg text-ink-soft"
        data-reveal
        style="--reveal-delay:0.08s"
      >
        Pieces come and go with the towels we find. Message us on Instagram or
        send a note, and we will tell you what is in the basket right now.
      </p>
      <div
        class="mt-7 flex flex-wrap justify-center gap-3"
        data-reveal
        style="--reveal-delay:0.14s"
      >
        <a
          href={SITE.instagram.url}
          class="rounded-full bg-[var(--accent)] px-6 py-3 text-sm font-semibold text-ink shadow-[3px_3px_0_var(--color-ink)] transition-transform duration-200 ease-soft hover:scale-[1.03] active:scale-[0.97]"
        >
          Instagram {SITE.instagram.handle}
        </a>
        <a
          href="/contact/"
          class="rounded-full border-2 border-ink px-6 py-3 text-sm font-semibold text-ink transition-colors duration-200 hover:bg-ink/5"
        >
          Get in touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
